# local：使用本机 SQLite
# supabase：使用 Supabase PostgreSQL
NEXT_PUBLIC_DATA_MODE=local

# Supabase 项目公开配置，可安全用于浏览器
NEXT_PUBLIC_SUPABASE_URL=
# 新项目优先使用 Publishable Key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# 兼容旧版 Supabase 项目的 anon key；未设置 Publishable Key 时使用
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 仅服务端使用，绝不能提交到 Git 或发送到浏览器
SUPABASE_SERVICE_ROLE_KEY=

# 保护 Vercel 定时心跳接口
CRON_SECRET=

# OpenAI-compatible AI 服务，例如 DeepSeek、通义千问或 OpenAI
AI_API_BASE_URL=https://api.deepseek.com
AI_API_KEY=
AI_MODEL=deepseek-flash
